#!/usr/bin/env python3
"""Launcher: works from a symlink (~/.claude/ds-toolkit/bin/dsguard) with no install step."""
import sys
from pathlib import Path

if sys.version_info < (3, 11):
    sys.exit("dsguard needs Python 3.11+ (tomllib)")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from dsguard.cli import main  # noqa: E402

sys.exit(main())
